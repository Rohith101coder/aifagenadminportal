# ====================================================================
# AIFaGen Labs Admin Portal - Environment Variables Template
# ====================================================================
# INSTRUCTIONS:
# 1. Copy this file to create your active local environment file:
#      copy example.env .env     (Windows Command Prompt)
#      cp example.env .env       (Linux / macOS / PowerShell)
# 2. Fill in your real API credentials below.
# 3. Security Warning: NEVER commit your actual '.env' file to Git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Artificial Intelligence Engine (Chatbot Co-Pilot & Voice Agent)
# --------------------------------------------------------------------
# Groq Cloud API Key (Primary ultra-fast inference for Llama 3.3 70B)
# Sign up and create an API key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (Automatic fallback inference provider)
# Sign up and create an API key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# --------------------------------------------------------------------
# 2. Transactional Email Dispatch (Brevo / Sendinblue)
# --------------------------------------------------------------------
# Brevo REST API v3 Key (Used for universal report dispatch via voice agent)
# Obtain your key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Verified Sender Email (Must match an authorized sender address in Brevo)
BREVO_SENDER_EMAIL=support@aifagenlabs.com

# --------------------------------------------------------------------
# 3. Direct SMTP Fallback Transport (Optional / Secondary Transport)
# --------------------------------------------------------------------
# Brevo SMTP login credentials (found in Brevo SMTP & API settings)
MAIL_USERNAME=your_smtp_login@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-your_smtp_password_here
